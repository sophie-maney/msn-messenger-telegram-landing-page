---
import Base from '../layouts/Base.astro';
import ContactList from '../components/ContactList.astro';
import SignInToast from '../components/SignInToast.astro';
import { release, features } from '../site';

const done = (items: [string, boolean][]) => items.filter(([, d]) => d).length;
// Fixed columns, so collapsing a group never reflows groups into the other column
const featureColumns = [features.slice(0, 3), features.slice(3)];
---

<Base
  title="Messenger for Telegram"
  description="A Mac app that brings back Messenger 2009 for your Telegram chats: a small contact list, a window per conversation, status orbs, nudges and Aero glass."
>
  <header class="desktop">
    <div class="desktop__inner">
      <div class="desktop__window" id="nudge-target">
        <ContactList />
      </div>

      <div class="intro">
        <h1>Your Telegram chats, in Messenger</h1>
        <p class="intro__lede">
          A Mac app that brings back Messenger 2009 for Telegram: a small contact list, a window for every conversation,
          status orbs, nudges and Aero glass.
        </p>
        <div class="intro__actions">
          <a class="button button--default" href={release.dmg}>Download for Mac</a>
          <button class="button" type="button" id="nudge-button">Send a nudge</button>
        </div>
        <p class="intro__nudge-status" id="nudge-status" aria-live="polite"></p>
        <p class="intro__meta">
          Version {release.version} for macOS 26 on Apple Silicon. Free.
          <a href={release.notes}>What’s new in {release.version}</a>
        </p>
      </div>
    </div>

    <div class="desktop__toast">
      <SignInToast />
    </div>
  </header>

  <main>
    <section class="section" aria-labelledby="works-heading">
      <h2 id="works-heading">What works today</h2>
      <p class="section__lede">
        Version {release.version} covers most of everyday Telegram. A <span class="orb" role="img" aria-label="green"></span>
        green orb means it works. A <span class="orb orb--offline" role="img" aria-label="grey"></span> grey one means it’s
        not there yet.
      </p>

      <div class="features">
        {featureColumns.map((column) => (
          <div class="features__column">
            {column.map((g) => (
              <details class="feature-group" open>
                <summary>
                  <svg class="tree-arrow" viewBox="0 0 10 10" aria-hidden="true">
                    <path class="tree-arrow__closed" d="M3 1.5l4 3.5-4 3.5z" />
                    <path class="tree-arrow__open" d="M8 2.5v5.5H2.5z" />
                  </svg>
                  {g.group} ({done(g.items)}/{g.items.length})
                </summary>
                <ul>
                  {g.items.map(([label, isDone]) => (
                    <li class:list={{ 'is-missing': !isDone }}>
                      <span class:list={['orb', { 'orb--offline': !isDone }]} />
                      <span>
                        {label}
                        {!isDone && <span class="visually-hidden"> (not yet)</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="details-heading">
      <h2 id="details-heading">Messenger, down to the details</h2>
      <dl class="details">
        <div>
          <dt>Nudges</dt>
          <dd>
            Send a nudge and your friend’s conversation window shakes. You still can’t send one more than every 15
            seconds. Friends on regular Telegram see the message “[Nudge]”.
          </dd>
        </div>
        <div>
          <dt>A window for every conversation</dt>
          <dd>Your contact list stays small. Each chat opens in its own window, with both display pictures beside it.</dd>
        </div>
        <div>
          <dt>Frames that show your status</dt>
          <dd>Display pictures sit in frames that turn green, orange or red as people come and go.</dd>
        </div>
        <div>
          <dt>Handwriting</dt>
          <dd>Switch the message box to the pen and draw your message instead of typing it.</dd>
        </div>
        <div>
          <dt>Scenes</dt>
          <dd>Your Telegram profile colour and pattern become your Messenger scene. Change them in the Scene dialog.</dd>
        </div>
        <div>
          <dt>Alerts the way you remember</dt>
          <dd>
            Choose Messenger’s alerts sliding up in the corner, macOS notifications, or the oldest way: the conversation
            window jumps to the front.
          </dd>
        </div>
      </dl>
    </section>

    <section class="section" aria-labelledby="install-heading">
      <h2 id="install-heading">Install it</h2>
      <p class="section__lede">
        The app signs in to Telegram directly with Telegram’s own library, so your messages don’t pass through anyone
        else’s server.
      </p>
      <ol class="steps">
        <li>
          <h3>Download</h3>
          <p>
            <a href={release.dmg}>Download version {release.version}</a>. You need a Mac with Apple Silicon running
            macOS 26 or later.
          </p>
        </li>
        <li>
          <h3>Move it to Applications</h3>
          <p>Open the disk image and drag Messenger onto the Applications folder.</p>
        </li>
        <li>
          <h3>Open it the first time</h3>
          <p>
            Apple hasn’t notarized the app yet, so macOS blocks the first launch. Open System Settings, go to Privacy
            &amp; Security, and click Open Anyway. Updates install themselves after that.
          </p>
        </li>
        <li>
          <h3>Sign in</h3>
          <p>Use your phone number, or scan the QR code with Telegram on your phone.</p>
        </li>
      </ol>
    </section>
  </main>

  <footer class="footer">
    <p>
      Messenger for Telegram is a fan project. It isn’t affiliated with or endorsed by Microsoft or
      Telegram. Windows Live Messenger is a trademark of Microsoft.
    </p>
    <p>
      <a href={release.allReleases}>All releases</a>
      <span aria-hidden="true">&ensp;</span>
      Set in Selawik, under the <a href="/fonts/OFL.txt">SIL Open Font License</a>.
    </p>
  </footer>
</Base>

<style>
  /* Hero: a desktop with the app running on it */
  .desktop {
    position: relative;
    overflow: hidden;
    padding: clamp(32px, 7vw, 96px) var(--gutter) clamp(48px, 9vw, 120px);
    background:
      radial-gradient(70% 60% at 78% 30%, rgba(255, 255, 255, 0.55), transparent 70%),
      radial-gradient(60% 50% at 10% 110%, rgba(140, 220, 120, 0.45), transparent 70%),
      linear-gradient(165deg, #164a96 0%, var(--sky) 38%, #79b9ea 78%, #b9dcf6 100%);
  }
  /* Two soft light ribbons across the sky */
  .desktop::before,
  .desktop::after {
    content: '';
    position: absolute;
    left: -20%;
    width: 140%;
    height: 180px;
    border-radius: 50%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35) 40%, rgba(255, 255, 255, 0.05));
    filter: blur(18px);
    transform: rotate(-9deg);
    pointer-events: none;
  }
  .desktop::before {
    top: 38%;
  }
  .desktop::after {
    top: 58%;
    height: 90px;
    opacity: 0.6;
    transform: rotate(-6deg);
  }

  .desktop__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    max-width: 1120px;
    margin: 0 auto;
  }

  .intro {
    max-width: 34rem;
  }
  /* Win7's caption treatment, scaled up: dark text on a white glow */
  h1 {
    color: #0d2b63;
    font-size: clamp(2.5rem, 5.2vw, var(--t-56));
    font-weight: 350;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-shadow:
      0 0 18px rgba(255, 255, 255, 0.95),
      0 0 36px rgba(255, 255, 255, 0.7);
  }
  .intro__lede {
    max-width: 30rem;
    margin-top: 20px;
    color: #0f2a55;
    font-size: var(--t-21);
    line-height: 1.45;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.9);
  }
  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .intro__nudge-status {
    min-height: 1.4em;
    margin-top: 10px;
    color: #0f2a55;
    font-size: var(--t-15);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
  }
  .intro__meta {
    margin-top: 4px;
    color: #0f2a55;
    font-size: var(--t-15);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
  }
  .intro__meta a {
    margin-left: 0.4em;
    color: #0b3f8f;
  }

  .desktop__toast {
    position: absolute;
    z-index: 2;
    right: 20px;
    bottom: 20px;
  }

  /* WLM's nudge: about a second of jitter */
  :global(.is-nudged) {
    animation: nudge 900ms linear;
  }
  @keyframes nudge {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-9px, 4px); }
    20% { transform: translate(8px, -6px); }
    30% { transform: translate(-7px, -3px); }
    40% { transform: translate(9px, 5px); }
    50% { transform: translate(-6px, 6px); }
    60% { transform: translate(7px, -5px); }
    70% { transform: translate(-8px, 2px); }
    80% { transform: translate(5px, 4px); }
    90% { transform: translate(-3px, -2px); }
  }

  :global(.toast-in) {
    animation: toast-in 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(.toast-out) {
    animation: toast-in 350ms ease-in reverse forwards;
  }
  @keyframes toast-in {
    from {
      transform: translateY(calc(100% + 24px));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.is-nudged) {
      animation: nudge-still 900ms steps(1);
    }
    @keyframes nudge-still {
      0%, 50% { outline: 3px solid #fff; outline-offset: 4px; border-radius: 8px; }
    }
    :global(.toast-in),
    :global(.toast-out) {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .desktop {
      padding-bottom: 170px;
      background:
        radial-gradient(120% 45% at 30% 14%, rgba(255, 255, 255, 0.6), transparent 75%),
        radial-gradient(60% 50% at 10% 110%, rgba(140, 220, 120, 0.45), transparent 70%),
        linear-gradient(170deg, #3f86d2 0%, #6aaee6 45%, var(--sky) 75%, #79b9ea 100%);
    }
    .desktop__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      order: -1;
    }
    .desktop__window {
      display: flex;
      justify-content: center;
    }
    .desktop__toast {
      right: 50%;
      transform: translateX(50%);
    }
  }

  /* Below the desktop: plain pages of a Win7 dialog */
  .section {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 96px) var(--gutter) 0;
  }
  h2 {
    color: var(--instruction);
    font-size: clamp(var(--t-28), 4vw, var(--t-40));
    font-weight: 350;
    line-height: 1.15;
  }
  .section__lede {
    max-width: var(--measure);
    margin-top: 12px;
    color: var(--ink);
  }
  .section__lede .orb {
    margin: 0 0.3em 0 0.1em;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    align-items: start;
    column-gap: 56px;
    margin-top: 32px;
  }
  .feature-group {
    margin-bottom: 24px;
  }
  .feature-group summary {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
    color: #1e395b;
    font-size: var(--t-17);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .feature-group summary::-webkit-details-marker {
    display: none;
  }
  .tree-arrow {
    width: 10px;
    height: 10px;
  }
  .tree-arrow__closed {
    fill: none;
    stroke: #8c8c8c;
  }
  .tree-arrow__open {
    display: none;
    fill: #595959;
  }
  .feature-group[open] .tree-arrow__closed {
    display: none;
  }
  .feature-group[open] .tree-arrow__open {
    display: block;
  }
  .feature-group ul {
    padding: 4px 0 0 16px;
    list-style: none;
  }
  .feature-group li {
    display: flex;
    gap: 10px;
    padding: 3px 0;
    line-height: 1.4;
  }
  .feature-group li .orb {
    margin-top: 0.3em;
  }
  .feature-group li.is-missing {
    color: var(--ink-quiet);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 32px 56px;
    max-width: 960px;
    margin-top: 32px;
  }
  .details dt {
    color: #1e395b;
    font-weight: 600;
  }
  .details dd {
    margin-top: 4px;
    max-width: 44ch;
  }

  .steps {
    display: grid;
    gap: 24px;
    max-width: var(--measure);
    margin-top: 32px;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding-left: 52px;
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    top: -2px;
    left: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid #3c7fb1;
    border-radius: 50%;
    background: linear-gradient(#f0f8fd, #b3dcf5);
    color: var(--instruction);
    font-weight: 600;
  }
  .steps h3 {
    color: #1e395b;
    font-size: var(--t-17);
    font-weight: 600;
  }
  .steps p {
    margin-top: 2px;
  }

  .footer {
    display: grid;
    gap: 8px;
    max-width: 1120px;
    margin: clamp(72px, 10vw, 120px) auto 0;
    padding: 28px var(--gutter) 40px;
    border-top: 1px solid var(--rule);
    color: var(--ink-quiet);
    font-size: var(--t-15);
  }
  .footer p {
    max-width: var(--measure);
  }
</style>

<script>
  const NUDGE_INTERVAL = 15_000;

  // Status menu: recolours your picture frame like WLM's
  const statusButton = document.getElementById('status-button')!;
  const statusMenu = document.getElementById('status-menu')!;
  const statusLabel = document.getElementById('status-label')!;
  const myPicture = document.getElementById('my-picture')!;
  const items = [...statusMenu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')];

  function setMenu(open: boolean) {
    statusMenu.hidden = !open;
    statusButton.setAttribute('aria-expanded', String(open));
    if (open) (items.find((i) => i.getAttribute('aria-checked') === 'true') ?? items[0]).focus();
  }

  statusButton.addEventListener('click', () => setMenu(statusMenu.hidden));
  for (const item of items) {
    item.addEventListener('click', () => {
      const status = item.dataset.status!;
      for (const i of items) i.setAttribute('aria-checked', String(i === item));
      myPicture.dataset.status = status;
      statusLabel.textContent = `(${item.textContent!.trim()})`;
      setMenu(false);
      statusButton.focus();
    });
  }
  statusMenu.addEventListener('keydown', (e) => {
    const at = items.indexOf(document.activeElement as HTMLButtonElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      items[(at + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus();
    } else if (e.key === 'Escape') {
      setMenu(false);
      statusButton.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!statusMenu.hidden && !statusMenu.parentElement!.contains(e.target as Node)) setMenu(false);
  });

  // Contact search
  const search = document.getElementById('contact-search') as HTMLInputElement;
  const groups = [...document.querySelectorAll<HTMLDetailsElement>('#contact-groups .group')];
  const empty = document.getElementById('search-empty')!;
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let any = false;
    for (const g of groups) {
      let shown = 0;
      for (const c of g.querySelectorAll<HTMLElement>('.contact')) {
        const match = !q || c.dataset.name!.includes(q);
        c.hidden = !match;
        if (match) shown++;
      }
      g.hidden = shown === 0;
      if (q && shown) g.open = true;
      any ||= shown > 0;
    }
    empty.hidden = any;
  });

  // Nudges, with Messenger's own rate limit
  const nudgeButton = document.getElementById('nudge-button')!;
  const nudgeTarget = document.getElementById('nudge-target')!;
  const nudgeStatus = document.getElementById('nudge-status')!;
  let lastNudge = -Infinity;

  nudgeButton.addEventListener('click', () => {
    const wait = lastNudge + NUDGE_INTERVAL - performance.now();
    if (wait > 0) {
      const s = Math.ceil(wait / 1000);
      nudgeStatus.textContent = `You may not send a nudge that often. Try again in ${s} second${s === 1 ? '' : 's'}.`;
      return;
    }
    lastNudge = performance.now();
    nudgeTarget.classList.remove('is-nudged');
    void nudgeTarget.offsetWidth;
    nudgeTarget.classList.add('is-nudged');
    nudgeStatus.textContent = 'You have just sent a nudge.';
  });
  nudgeTarget.addEventListener('animationend', () => nudgeTarget.classList.remove('is-nudged'));

  // The one thing that moves by itself: a contact signs in
  const toast = document.getElementById('sign-in-toast')!;
  let toastTimer: number | undefined;

  function hideToast() {
    clearTimeout(toastTimer);
    toast.classList.remove('toast-in');
    toast.classList.add('toast-out');
    const done = () => {
      toast.hidden = true;
      toast.classList.remove('toast-out');
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
    else toast.addEventListener('animationend', done, { once: true });
  }

  document.getElementById('toast-close')!.addEventListener('click', hideToast);
  setTimeout(() => {
    toast.hidden = false;
    toast.classList.add('toast-in');
    toastTimer = window.setTimeout(hideToast, 8000);
  }, 1400);
  toast.addEventListener('mouseenter', () => clearTimeout(toastTimer));
  toast.addEventListener('mouseleave', () => (toastTimer = window.setTimeout(hideToast, 4000)));
</script>
