---
/**
 * A display picture in WLM's presence frame. The pictures are drawn here,
 * not taken from Messenger's own user tiles.
 */
interface Props {
  picture: 'meadow' | 'bubbles';
  size: number;
  status?: 'available' | 'busy' | 'away' | 'offline';
  id?: string;
}

const { picture, size, status = 'available', id } = Astro.props;
const uid = `${picture}-${Math.random().toString(36).slice(2, 7)}`;
---

<span class="frame" data-status={status} id={id} style={`--size: ${size}px`}>
  {
    picture === 'meadow' ? (
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3f8fe0" />
            <stop offset="1" stop-color="#bfe3fb" />
          </linearGradient>
          <linearGradient id={`${uid}-hill`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8ad04a" />
            <stop offset="1" stop-color="#2f8a2a" />
          </linearGradient>
        </defs>
        <rect width="64" height="64" fill={`url(#${uid}-sky)`} />
        <circle cx="47" cy="17" r="8" fill="#fff6c4" />
        <circle cx="47" cy="17" r="13" fill="#fff6c4" opacity="0.3" />
        <path d="M0 44 C 16 32, 34 34, 64 46 L64 64 L0 64 Z" fill={`url(#${uid}-hill)`} />
        <path d="M0 52 C 22 44, 40 46, 64 56 L64 64 L0 64 Z" fill="#2d7d27" opacity="0.6" />
      </svg>
    ) : (
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id={`${uid}-sea`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#16a3b8" />
            <stop offset="1" stop-color="#0b5a8f" />
          </linearGradient>
          <radialGradient id={`${uid}-bubble`} cx="0.35" cy="0.3" r="0.7">
            <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
            <stop offset="0.5" stop-color="#fff" stop-opacity="0.2" />
            <stop offset="1" stop-color="#fff" stop-opacity="0.55" />
          </radialGradient>
        </defs>
        <rect width="64" height="64" fill={`url(#${uid}-sea)`} />
        <circle cx="22" cy="38" r="15" fill={`url(#${uid}-bubble)`} />
        <circle cx="45" cy="20" r="9" fill={`url(#${uid}-bubble)`} />
        <circle cx="48" cy="46" r="5" fill={`url(#${uid}-bubble)`} />
      </svg>
    )
  }
</span>

<style>
  .frame {
    --c: var(--available);
    --c-dark: var(--available-dark);
    flex: none;
    display: inline-block;
    width: var(--size);
    height: var(--size);
    padding: calc(var(--size) * 0.085);
    border: 1px solid var(--c-dark);
    border-radius: calc(var(--size) * 0.16);
    background-color: var(--c);
    background-image: linear-gradient(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.1) 45%, rgba(0, 0, 0, 0.12));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.45),
      0 1px 3px rgba(0, 30, 70, 0.3);
    transition:
      background-color 300ms ease,
      border-color 300ms ease;
  }
  .frame[data-status='busy'] {
    --c: var(--busy);
    --c-dark: var(--busy-dark);
  }
  .frame[data-status='away'] {
    --c: var(--away);
    --c-dark: var(--away-dark);
  }
  .frame[data-status='offline'] {
    --c: var(--offline);
    --c-dark: var(--offline-dark);
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(0, 0, 0, 0.35);
    border-radius: calc(var(--size) * 0.07);
  }
</style>
